<view class="page">
  <view class="between section">
    <view class="title" style="margin-bottom:0;">消息通知</view>
    <van-button size="small" plain bindtap="onMarkAllRead">全部已读</van-button>
  </view>

  <view class="notif-card" wx:if="{{notifications.length}}">
    <view class="notif-item" wx:for="{{notifications}}" wx:key="id"
          data-item="{{item}}" bindtap="onTapNotification">
      <view class="notif-dot {{item.isRead ? 'read' : 'unread'}}"></view>
      <view class="notif-content">
        <view class="between">
          <view class="notif-title" style="{{item.isRead ? 'color:#6b7280;font-weight:400;' : ''}}">{{item.title}}</view>
          <view class="notif-time">{{item.createdAt}}</view>
        </view>
        <view class="notif-desc">{{item.content}}</view>
      </view>
    </view>
  </view>

  <van-empty wx:if="{{!loading && !notifications.length}}" description="暂无通知" />
  <view class="section" wx:if="{{loading}}" style="text-align:center;padding:48rpx 0;">
    <van-loading size="24px" vertical>加载中...</van-loading>
  </view>
</view>
