<view class="page">
  <view class="between section">
    <view class="title">通知</view>
    <van-button size="small" plain bindtap="onMarkAllRead">全部已读</van-button>
  </view>

  <view class="section" wx:if="{{notifications.length}}">
    <view class="list-item" wx:for="{{notifications}}" wx:key="id"
          data-item="{{item}}" bindtap="onTapNotification">
      <view class="between">
        <view class="item-title" style="{{item.isRead ? 'color:#6b7280' : ''}}">
          <text wx:if="{{!item.isRead}}" style="color:#2563eb;margin-right:8rpx;">●</text>
          {{item.title}}
        </view>
        <view class="muted">{{item.createdAt}}</view>
      </view>
      <view class="item-meta">{{item.content}}</view>
    </view>
  </view>

  <van-empty wx:if="{{!loading && !notifications.length}}" description="暂无通知" />
  <view class="section" wx:if="{{loading}}" style="text-align:center;padding:48rpx 0;">
    <van-loading size="24px" vertical>加载中...</van-loading>
  </view>
</view>
