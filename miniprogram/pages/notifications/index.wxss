/* 通知卡片 */
.notif-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.notif-item {
  display: flex;
  padding: 24rpx 28rpx;
  gap: 20rpx;
  align-items: flex-start;
}
.notif-item + .notif-item {
  border-top: 1rpx solid #f3f4f6;
}
.notif-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 10rpx;
}
.notif-dot.unread {
  background: #2563eb;
  box-shadow: 0 0 0 4rpx rgba(37, 99, 235, 0.15);
}
.notif-dot.read {
  background: #d1d5db;
}
.notif-content {
  flex: 1;
  min-width: 0;
}
.notif-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.notif-time {
  font-size: 22rpx;
  color: #b0b8c9;
  flex-shrink: 0;
}
.notif-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
  line-height: 1.5;
}
