<view class="page">
  <!-- 用户头像卡片 -->
  <view class="avatar-card">
    <view class="avatar">👤</view>
    <view class="avatar-name">{{userInfo.username || '-'}}</view>
    <view class="avatar-role" wx:if="{{userInfo.orgRole}}">{{userInfo.orgRole === 'viewer' ? '生产员' : userInfo.orgRole}}</view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="showChangePassword">
      <view class="menu-icon blue">🔒</view>
      <view class="menu-text">修改密码</view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onLogout">
      <view class="menu-icon red">🚪</view>
      <view class="menu-text danger">退出登录</view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 修改密码弹窗 -->
  <van-dialog
    show="{{showPasswordDialog}}"
    title="修改密码"
    show-cancel-button
    loading="{{saving}}"
    bind:confirm="onChangePassword"
    bind:cancel="hideChangePassword"
  >
    <van-field
      type="password"
      placeholder="请输入旧密码"
      value="{{oldPassword}}"
      data-field="oldPassword"
      bind:input="onInput"
    />
    <van-field
      type="password"
      placeholder="请输入新密码"
      value="{{newPassword}}"
      data-field="newPassword"
      bind:input="onInput"
    />
    <van-field
      type="password"
      placeholder="请再次输入新密码"
      value="{{confirmPassword}}"
      data-field="confirmPassword"
      bind:input="onInput"
    />
  </van-dialog>
</view>
