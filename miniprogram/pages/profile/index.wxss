/* 头像卡片 */
.avatar-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}
.avatar-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  position: relative;
  z-index: 1;
  border: 6rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.3);
}
.avatar-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  position: relative;
  z-index: 1;
}
.avatar-role {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

/* 菜单卡片 */
.menu-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 20rpx;
}
.menu-item + .menu-item {
  border-top: 1rpx solid #f3f4f6;
}
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.menu-icon.blue {
  background: #eef4ff;
}
.menu-icon.red {
  background: #fef2f2;
}
.menu-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}
.menu-text.danger {
  color: #ef4444;
}
.menu-arrow {
  font-size: 32rpx;
  color: #d1d5db;
}
