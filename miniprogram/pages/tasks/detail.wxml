<view class="page">
  <!-- 加载中 -->
  <view class="section" wx:if="{{loading}}" style="text-align:center;padding:48rpx 0;">
    <van-loading size="24px" vertical>加载中...</van-loading>
  </view>

  <block wx:if="{{task && !loading}}">
    <!-- 状态 Hero 卡片 -->
    <view class="hero-card">
      <view class="hero-top">
        <view>
          <view class="hero-label">订单号</view>
          <view class="hero-id">{{task.orderNo || '-'}}</view>
        </view>
        <van-tag wx:if="{{task.status === 0}}" type="warning" round>待处理</van-tag>
        <van-tag wx:elif="{{task.status === 1}}" type="primary" round>生产中</van-tag>
        <van-tag wx:else type="success" round>已完成</van-tag>
      </view>
      <view class="hero-stats">
        <view class="hero-stat">
          <view class="hero-stat-label">任务名称</view>
          <view class="hero-stat-value">{{task.taskName || '未命名'}}</view>
        </view>
        <view class="hero-stat" wx:if="{{task.estimatedHours}}">
          <view class="hero-stat-label">预计工时</view>
          <view class="hero-stat-value">{{task.estimatedHours}}h</view>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="section">
      <view class="section-title">基本信息</view>
      <view class="field" wx:if="{{task.startTime}}">
        <view class="label">开始时间</view>
        <view>{{task.startTime}}</view>
      </view>
      <view class="field" wx:if="{{task.completeTime}}">
        <view class="label">完成时间</view>
        <view>{{task.completeTime}}</view>
      </view>
      <view class="field" wx:if="{{task.remark}}">
        <view class="label">备注</view>
        <view>{{task.remark}}</view>
      </view>
      <view class="field" wx:if="{{!task.startTime && !task.completeTime && !task.remark}}">
        <view style="color:#9ca3af;font-size:26rpx;">暂无更多信息</view>
      </view>
    </view>

    <!-- 板材信息 -->
    <view class="section" wx:if="{{items.length}}">
      <view class="section-title">板材信息</view>
      <view class="board-info">
        <view class="field">
          <view class="label">品牌</view>
          <view>{{items[0].brand || '-'}}</view>
        </view>
        <view class="field">
          <view class="label">材质</view>
          <view>{{items[0].materialName || '-'}}</view>
        </view>
        <view class="field">
          <view class="label">颜色</view>
          <view>{{items[0].color || '-'}}</view>
        </view>
        <view class="field">
          <view class="label">厚度</view>
          <view>{{items[0].thickness ? items[0].thickness + 'mm' : '-'}}</view>
        </view>
      </view>
    </view>

    <!-- 部件明细 -->
    <view class="section" wx:if="{{items.length}}">
      <view class="section-title">部件明细</view>
      <view class="table-header">
        <view class="col-name">名称</view>
        <view class="col-size">尺寸</view>
        <view class="col-qty">数量</view>
      </view>
      <view class="table-row" wx:for="{{items}}" wx:key="itemId">
        <view class="col-name">{{item.partName || '-'}}</view>
        <view class="col-size">{{item.length}}×{{item.width}}</view>
        <view class="col-qty">{{item.quantity}}</view>
      </view>
    </view>

    <!-- NC 文件下载 -->
    <view class="section" wx:if="{{layoutResult.ncFilePath}}">
      <view class="section-title">NC 文件</view>
      <van-button type="default" block bindtap="onDownloadNc">下载 NC 文件</van-button>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar" wx:if="{{task.status === 0 || task.status === 1}}">
      <van-button wx:if="{{task.status === 0}}" type="primary" block loading="{{transitioning}}" bindtap="onStart">开始生产</van-button>
      <van-button wx:if="{{task.status === 1}}" type="primary" block loading="{{transitioning}}" bindtap="onComplete">完成任务</van-button>
    </view>
  </block>
</view>
