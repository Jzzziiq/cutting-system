/* Hero 卡片 */
.hero-card {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  position: relative;
  overflow: hidden;
}
.hero-card::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}
.hero-label {
  font-size: 22rpx;
  opacity: 0.7;
}
.hero-id {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 6rpx;
}
.hero-stats {
  display: flex;
  gap: 48rpx;
  position: relative;
  z-index: 1;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
}
.hero-stat-label {
  font-size: 22rpx;
  opacity: 0.6;
}
.hero-stat-value {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 区域标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
}
.board-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.table-header {
  display: flex;
  background: #f5f7fa;
  padding: 14rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6b7280;
  border-radius: 10rpx 10rpx 0 0;
}
.table-row {
  display: flex;
  padding: 16rpx;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.col-name { flex: 2; font-weight: 500; }
.col-size { flex: 2; text-align: center; color: #6b7280; }
.col-qty { flex: 1; text-align: center; font-weight: 600; }
.action-bar {
  padding: 24rpx 0;
}
