<view class="page">
  <!-- 标题栏 -->
  <view class="between section">
    <view class="title" style="margin-bottom:0;">我的任务</view>
    <view class="bell-btn" bindtap="goNotifications">
      <text class="bell-icon">🔔</text>
      <van-info wx:if="{{unreadCount > 0}}" content="{{unreadCount > 99 ? '99+' : unreadCount}}" style="position:absolute;top:-8rpx;right:-8rpx;" />
    </view>
  </view>

  <!-- 任务列表 -->
  <view wx:if="{{tasks.length}}">
    <view class="task-card status-{{item.status === 0 ? 'pending' : item.status === 1 ? 'progress' : 'done'}}"
          wx:for="{{tasks}}" wx:key="taskId" data-id="{{item.taskId}}" bindtap="goDetail">
      <view class="between">
        <view class="item-title">{{item.taskName || '未命名任务'}}</view>
        <van-tag wx:if="{{item.status === 0}}" type="warning">待处理</van-tag>
        <van-tag wx:elif="{{item.status === 1}}" type="primary">生产中</van-tag>
        <van-tag wx:else type="success">已完成</van-tag>
      </view>
      <view class="item-meta">订单号：{{item.orderNo || '-'}}</view>
      <view class="item-meta" wx:if="{{item.estimatedHours}}">预计工时：{{item.estimatedHours}}h</view>
    </view>
  </view>

  <!-- 空状态 -->
  <van-empty wx:if="{{!loading && !tasks.length}}" description="暂无任务" />

  <!-- 加载中 -->
  <view class="section" wx:if="{{loading}}" style="text-align:center;padding:48rpx 0;">
    <van-loading size="24px" vertical>加载中...</van-loading>
  </view>
</view>
